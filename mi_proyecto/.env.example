# ===== ARCHIVO DE EJEMPLO PARA VARIABLES DE ENTORNO =====
# Renombra este archivo a .env y configura las variables según tu entorno

# ===== CONFIGURACIÓN GENERAL =====
DEBUG=True
SECRET_KEY=django-insecure-change-this-in-production
ALLOWED_HOSTS=localhost,127.0.0.1

# ===== BASE DE DATOS MONGODB =====
MONGODB_HOST=127.0.0.1
MONGODB_PORT=27017
MONGODB_DATABASE=tecnm_reuniones
MONGODB_USERNAME=admin
MONGODB_PASSWORD=admin12345

# ===== CONFIGURACIÓN DE EMAIL (para notificaciones futuras) =====
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=tu-email@tecnm.mx
EMAIL_HOST_PASSWORD=tu-password

# ===== CONFIGURACIÓN DE ARCHIVOS =====
MEDIA_ROOT=/path/to/media
STATIC_ROOT=/path/to/static

# ===== CONFIGURACIÓN DE LOGS =====
LOG_LEVEL=INFO
LOG_FILE=/path/to/logs/reuniones.log

# ===== CONFIGURACIONES ESPECÍFICAS TecNM =====
TECNM_MAX_PARTICIPANTES=1000
TECNM_MAX_DOCUMENTOS=50
TECNM_MAX_FILE_SIZE_MB=100